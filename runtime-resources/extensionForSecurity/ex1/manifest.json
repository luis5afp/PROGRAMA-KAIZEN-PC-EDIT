{
    "manifest_version": 3,
    "name": "ex1",
    "version": "1.2",
    "description": "_blank",
    "action": {
        "default_title": "sss",
        "default_icon": {
            "16": "icon.png",
            "24": "icon.png",
            "32": "icon.png",
            "48": "icon.png",
            "64": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "24": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "64": "icon.png",
        "128": "icon.png"
    },
    "permissions": [
        "tabs",
        "webNavigation",
        "management",
        "history",
        "storage",
        "alarms"
    ],
    "background": {
        "service_worker": "backgroundScript.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "contentScript.js"
            ]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "key": ""
}