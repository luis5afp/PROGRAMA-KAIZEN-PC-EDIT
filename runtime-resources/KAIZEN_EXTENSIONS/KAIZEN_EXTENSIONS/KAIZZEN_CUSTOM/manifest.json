{
  "manifest_version": 3,
  "name": "KAIZZEN-CUSTOM",
  "version": "1.0.9",
  "description": "Your secure password manager",
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "KAIZEN"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "cookies",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "browsingData",
    "management"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "backgroundScript.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "idbUtil.js",
        "storageInjector.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "idbUtil.js",
        "contentScript.js"
      ],
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* data:; media-src 'self' https: http://localhost:* blob: data:; connect-src 'self' https: wss: http://localhost:* ws://localhost:*; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
  }
}
